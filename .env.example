# ===========================================
# DeepSeek AI API (用于 AI 对话/辅导功能)
# ===========================================
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===========================================
# Cloudflare Workers 部署
# ===========================================
# 注意: DEEPSEEK_API_KEY 是敏感信息，必须通过 wrangler secret 设置
# 不要将其写入 wrangler.toml 的 [vars] 中!
#
# 设置命令:
#   npx wrangler secret put DEEPSEEK_API_KEY
#
# 部署命令:
#   wyh12: npx wrangler deploy
#   wyh123: npx wrangler deploy -c .claude/cloudflare/wyh123.toml
#   怀:     npx wrangler deploy -c .claude/cloudflare/huai.toml
